<!DOCTYPE html>
<html>
<head>
  <title>Upcoming VibeOn Events</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #121212;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: white;
    }

    h1 {
      text-align: center;
      font-size: 3rem;
      color: #ff2e63;
      margin: 40px 0;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .events-wrapper {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 20px;
      padding: 20px;
      scroll-snap-type: x mandatory;
    }

    .event-card {
      flex: 0 0 300px;
      background: linear-gradient(to right, #1f1f1f, #0d0d0d);
      border-radius: 15px;
      overflow: hidden;
      color: white;
      scroll-snap-align: start;
      box-shadow: 0 8px 20px rgba(255, 46, 99, 0.3);
      transition: transform 0.3s ease;
    }

    .event-card:hover {
      transform: scale(1.05);
    }

    .event-card img {
      width: 100%;
      height: 180px;
      object-fit: cover;
    }

    .event-info {
      padding: 20px;
    }

    .event-title {
      font-size: 1.5rem;
      color: #ff2e63;
      margin-bottom: 10px;
    }

    .event-detail {
      font-size: 0.9rem;
      color: #ccc;
      margin: 6px 0;
    }

    .book-btn {
      display: inline-block;
      margin-top: 15px;
      padding: 10px 20px;
      background-color: #ff2e63;
      color: white;
      text-decoration: none;
      font-weight: bold;
      border-radius: 10px;
      transition: background-color 0.3s ease;
    }

    .book-btn:hover {
      background-color: #ff4f7c;
    }

    footer {
      text-align: center;
      padding: 30px;
      font-size: 0.9rem;
      color: #555;
    }
  </style>
</head>
<body>

  <h1>🎧 Upcoming Vibes</h1>

  <div class="events-wrapper">
    <% events = [
      { title: "Neon Beats Night", image: "https://source.unsplash.com/400x200/?concert,party,1", location: "Mumbai", date: "2025-07-15", info: "Electrifying EDM night." },
      { title: "Rock Reloaded", image: "https://source.unsplash.com/400x200/?rock,concert,2", location: "Delhi", date: "2025-07-20", info: "Heavy rock storm incoming." },
      { title: "Bollywood Bass", image: "https://source.unsplash.com/400x200/?bollywood,concert,3", location: "Bangalore", date: "2025-07-25", info: "Dance to Bollywood beats." },
      { title: "Trap Vibes", image: "https://source.unsplash.com/400x200/?trap,music,4", location: "Hyderabad", date: "2025-08-01", info: "High energy trap sets." },
      { title: "Sunset Chillout", image: "https://source.unsplash.com/400x200/?sunset,concert,5", location: "Goa", date: "2025-08-10", info: "Beach + Music = Bliss." },
      { title: "Night Pulse", image: "https://source.unsplash.com/400x200/?nightclub,dj,6", location: "Pune", date: "2025-08-18", info: "All-night dance floor heat." },
      { title: "Electro Fest", image: "https://source.unsplash.com/400x200/?electronic,festival,7", location: "Chennai", date: "2025-08-25", info: "Biggest electro fest ever." }
    ] %>

    <% events.each_with_index do |event, i| %>
      <div class="event-card">
        <img src="<%= event[:image] %>" alt="<%= event[:title] %>">
        <div class="event-info">
          <div class="event-title"><%= event[:title] %></div>
          <div class="event-detail">📍 <%= event[:location] %></div>
          <div class="event-detail">📅 <%= Date.parse(event[:date]).strftime("%B %d, %Y") %></div>
          <div class="event-detail">ℹ️ <%= event[:info] %></div>
          <%= link_to "Book Now", new_booking_path(event_id: i + 1), class: "book-btn" %>
        </div>
      </div>
    <% end %>
  </div>

  <footer>
    © 2025 VibeOn. All rights reserved.
  </footer>

</body>
</html>
