<!DOCTYPE html>
<html>
<head>
  <title>Create Event | VibeOn</title>
  <style>
    body {
      background: linear-gradient(135deg, #2b1055, #7597de);
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: white;
      text-align: center;
      padding: 50px;
    }

    h1 {
      font-size: 2.8rem;
      margin-bottom: 30px;
    }

    .form-container {
      background-color: rgba(255, 255, 255, 0.1);
      padding: 40px;
      border-radius: 20px;
      max-width: 600px;
      margin: 0 auto;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
    }

    .form-container label {
      display: block;
      margin-bottom: 8px;
      font-weight: bold;
      color: #fff;
      text-align: left;
    }

    .form-container input,
    .form-container textarea {
      width: 100%;
      padding: 12px;
      margin-bottom: 20px;
      border: none;
      border-radius: 10px;
      font-size: 1rem;
    }

    .btn {
      background-color: #ff4b2b;
      border: none;
      color: white;
      padding: 15px 30px;
      font-size: 1.2rem;
      border-radius: 30px;
      cursor: pointer;
      box-shadow: 0 8px 16px rgba(0,0,0,0.3);
      transition: all 0.3s ease;
    }

    .btn:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 20px rgba(0,0,0,0.4);
    }
  </style>
</head>
<body>
  <h1>📣 Create Your Event</h1>

  <div class="form-container">
    <%= form_with model: @event, local: true do |f| %>
      <div>
        <%= f.label :title %>
        <%= f.text_field :title %>
      </div>

      <div>
        <%= f.label :description %>
        <%= f.text_area :description %>
      </div>

      <div>
        <%= f.label :location %>
        <%= f.text_field :location %>
      </div>

      <div>
        <%= f.label :date %>
        <%= f.datetime_select :date %>
      </div>

      <div>
        <%= f.label :max_seats %>
        <%= f.number_field :max_seats %>
      </div>

      <div>
        <%= f.submit "Create Event", class: "btn" %>
      </div>
    <% end %>
  </div>
</body>
</html>
